# ---------------------------------------------------------------------------
# Supabase
# Local con Docker:  npx supabase start  (imprime la URL y las llaves)
# En la nube:        Project Settings > API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor. NUNCA con prefijo NEXT_PUBLIC_ ni en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Correo transaccional (invitaciones, avisos de sesión y de votación)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Discucharlas <hola@discucharlas.mx>"

# ---------------------------------------------------------------------------
# Aplicación
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CLUB_TIMEZONE=America/Mexico_City

# Firma de la cookie de invitada. Genera uno con: openssl rand -base64 32
GUEST_SESSION_SECRET=
